[Unit]
Description=Desk display
After=network-online.target
Wants=network-online.target

[Service]
User=%i
WorkingDirectory=/home/%i/desk-display
ExecStart=/home/%i/.venvs/display/bin/python /home/%i/desk-display/current/desk_display.py
# port 80, so phones open the Wi-Fi setup page by themselves
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
